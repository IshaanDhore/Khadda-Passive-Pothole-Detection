;"><mxGeometry x="825" y="605" width="200" height="35" as="geometry"/></mxCell><mxCell id="m12" parent="1" edge="1" source="sys" target="driver" style="edgeStyle=none;rounded=0;html=1;strokeColor=#555555;strokeWidth=1.2;dashed=1;endArrow=classic;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m12_label" value="12. Generate Pothole Alert&lt;br&gt;(Location, Severity)" parent="1" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#222222;fontSize=12;align=center;verticalAlign=middle;"><mxGeometry x="230" y="630" width="300" height="45" as="geometry"/></mxCell><mxCell id="m13" parent="1" edge="1" source="sys" target="rma" style="edgeStyle=none;rounded=0;html=1;strokeColor=#555555;strokeWidth=1.2;dashed=1;endArrow=classic;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m13_label" value="13. Generate Pothole Report&lt;br&gt;(Pothole Details &amp; Location)" parent="1" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#222222;fontSize=12;align=center;verticalAlign=middle;"><mxGeometry x="270" y="670" width="430" height="45" as="geometry"/></mxCell><mxCell id="m14" parent="1" edge="1" source="rma" target="db" style="edgeStyle=none;rounded=0;html=1;strokeColor=#333333;strokeWidth=1.2;endArrow=classic;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m14_label" value="14. Update Repair Status&lt;br&gt;(Pothole ID, Status)" parent="1" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#222222;fontSize=12;align=center;verticalAlign=middle;"><mxGeometry x="1120" y="515" width="245" height="45" as="geometry"/></mxCell><mxCell id="m15" parent="1" edge="1" source="db" target="rma" style="edgeStyle=none;rounded=0;html=1;strokeColor=#555555;strokeWidth=1.2;dashed=1;endArrow=classic;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m15_label" value="15. Status Updated" parent="1" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#222222;fontSize=12;align=center;verticalAlign=middle;"><mxGeometry x="1150" y="555" width="180" height="35" as="geometry"/></mxCell><mxCell id="m16" parent="1" edge="1" source="db" target="sys" style="edgeStyle=none;rounded=0;html=1;strokeColor=#555555;strokeWidth=1.2;dashed=1;endArrow=classic;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m16_label" value="16. Send Updated Status" parent="1" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#222222;fontSize=12;align=center;verticalAlign=middle;"><mxGeometry x="820" y="605" width="240" height="35" as="geometry"/></mxCell><mxCell id="m17" parent="1" edge="1" source="sys" target="driver" style="edgeStyle=none;rounded=0;html=1;strokeColor=#555555;strokeWidth=1.2;dashed=1;endArrow=classic;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m17_label" value="17. Notify Updated Status&lt;br&gt;(if required)" parent="1" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#222222;fontSize=12;align=center;verticalAlign=middle;"><mxGeometry x="250" y="645" width="300" height="45" as="geometry"/></mxCell><mxCell id="notes" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;br&gt;
1. System collects acceleration data from accelerometer and location from GPS module.&lt;br&gt;
2. Data is processed to detect pothole using threshold-based detection.&lt;br&gt;
3. System checks for duplicate pothole in the database.&lt;br&gt;
4. If unique, priority is calculated and record is stored in the database.&lt;br&gt;
5. Alert is sent to driver and report is sent to road maintenance authority.&lt;br&gt;
6. Authority updates repair status which is reflected in the system." parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#555555;fillColor=none;fontColor=#222222;fontSize=12;align=left;verticalAlign=top;spacing=8;"><mxGeometry x="20" y="735" width="650" height="145" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
